package views

// Layout Base con Pico.css
templ Layout() {
	<!DOCTYPE html>
	<html lang="es">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Gimnasio - TP5 (Templ)</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
	</head>
	<body>
		<main class="container">
			<h1 style="text-align: center; margin-bottom: 2rem;">Panel de Administración del Gimnasio</h1>
			{ children... }
		</main>
	</body>
	</html>
}